{
  "openapi": "3.1.0",
  "info": {
    "title": "Beckhoff PLC REST API",
    "description": "Prototype 2 REST API for high-level machine commands and status.\n\nThe PLC is authoritative for command acceptance, execution, physical completion, interlocks, timing, and faults.\n\nAn HTTP 202 response means that a command request was received by the API. It does not mean that the physical operation has completed.",
    "version": "1.2.0"
  },
  "paths": {
    "/api/v1/system": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get API and communication status",
        "description": "Returns REST API version information, backend status, and the API heartbeat. Machine execution and fault state remain authoritative in the PLC.",
        "operationId": "system_api_v1_system_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/machine/snapshot": {
      "get": {
        "tags": [
          "Machine"
        ],
        "summary": "Get complete machine snapshot",
        "description": "Returns the current machine, engineering, input, output, command, and supported device states in one response.",
        "operationId": "snapshot_api_v1_machine_snapshot_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/machine/status": {
      "get": {
        "tags": [
          "Machine"
        ],
        "summary": "Get machine-level status",
        "description": "Returns high-level machine readiness, busy state, fault state, simulation state, and most recent fault information.",
