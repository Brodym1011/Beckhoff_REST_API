    "/api/v1/commands/door1": {
      "get": {
        "tags": [
          "Command Status"
        ],
        "summary": "Get Door 1 command status",
        "description": "Returns the most recent Door 1 command lifecycle and result.",
        "operationId": "cd1_api_v1_commands_door1_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Commands"
        ],
        "summary": "Submit a Door 1 command",
        "description": "Submits a high-level Door 1 Open, Close, ResetFault, or ClearCommand request. The PLC controls outputs, sensors, timing, interlocks, completion, and faults.",
        "operationId": "pd1_api_v1_commands_door1_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Request received by the API. Physical door operation may still be pending, executing, rejected, or faulted.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Unsupported Door 1 command."
          },
          "422": {
            "description": "Invalid request body or enum value."
          }
        }
      }
    },
